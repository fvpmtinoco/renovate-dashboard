# Personal access token with read_api scope
GITLAB__TOKEN=

# GitLab instance URL
GITLAB__URL=https://gitlab.com

# Comma-separated namespace/repo slugs, e.g. mygroup/repo1,mygroup/repo2
GITLAB__REPOS=namespace/repo1,namespace/repo2

# Resend API key (https://resend.com)
RESEND_API_KEY=

# Comma-separated recipient email addresses
DIGEST_RECIPIENTS=

# Cron expression for digest schedule (UTC). Default: Monday 9am UTC.
DIGEST_CRON=0 9 * * 1

# Auth0 — backend token validation (consumed by the api container)
AUTH0__DOMAIN=your-tenant.eu.auth0.com
AUTH0__AUDIENCE=https://your-api-identifier

# Auth0 — frontend build args (consumed by docker compose to build the web image)
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
